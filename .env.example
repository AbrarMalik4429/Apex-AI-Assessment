# Add secrets locally. Never paste them into chat or commit this file with real values.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/booking
# For Supabase, replace DATABASE_URL with a direct/session-pooler URL ending in ?sslmode=require
DATABASE_SSL_ROOT_CERT=certs/supabase-ca.crt
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# strict: use a model supporting Groq JSON schema; json: explicitly opt into JSON object mode
GROQ_RESPONSE_MODE=strict
GROQ_TIMEOUT_SECONDS=15
CLINIC_TIMEZONE=Asia/Riyadh
BOOKING_HORIZON_DAYS=90
SESSION_HOURS=8
CONFIRMATION_MINUTES=10
CANCELLATION_NOTICE_HOURS=24
# Agreed workflow assumes the same restriction for rescheduling; independently configurable.
RESCHEDULE_NOTICE_HOURS=24
# Synthetic local demo ONLY. Keep false on an internet-facing deployment.
DEMO_ENABLED=false

# Backend URLs. Frontend public settings are in frontend/.env.
# FRONTEND_URL is the exact allowed browser origin.
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
APP_HOST=127.0.0.1
APP_PORT=8000

# Local Docker demo only. Set deployment values separately.
LOCAL_POSTGRES_USER=postgres
LOCAL_POSTGRES_PASSWORD=postgres
LOCAL_POSTGRES_DB=booking
LOCAL_DATABASE_BIND=127.0.0.1:5432:5432
DOCKER_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/booking
DOCKER_APP_HOST=0.0.0.0
DOCKER_API_BIND=127.0.0.1:8000:8000
